SECRET_KEY=your-secret-key-here
SESSION_COOKIE_SECURE=false
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Must exactly match an authorized redirect URI in Google Cloud.
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback
# Enable only when the app is behind a trusted reverse proxy (for example Nginx).
TRUST_PROXY_HEADERS=false
# Migration/recovery: this Google email may claim the first existing manager with no email.
GOOGLE_BOOTSTRAP_EMAILS=manager@yourcompany.com
# Optional: restrict every login to one Google Workspace domain.
GOOGLE_ALLOWED_DOMAIN=
# Persistent CRM login duration; refreshed on each request.
LOGIN_SESSION_DAYS=3650
